# Smart Scholars Platform Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database
# Default: Local zero-config SQLite for immediate portability.
# PostgreSQL alternative: postgresql://postgres:password@localhost:5432/smartscholars?schema=public
DATABASE_URL="file:./dev.db"

# Security Secrets
JWT_SECRET="smartscholars-secure-jwt-auth-token-secret-replace-in-production"
SESSION_SECRET="smartscholars-session-cookie-encryption-secret-key"

# External Data Source Identification (Crossref & OpenAlex Polite Pool)
CROSSREF_MAILTO="integrity@smartscholars.in"
OPENALEX_EMAIL="integrity@smartscholars.in"

# Optional AI Assistant (Gemini API). If absent, platform uses deterministic integrity engine fallback.
GEMINI_API_KEY=""

# Background Worker Settings
JOB_POLL_INTERVAL_MS=2000
MAX_CONCURRENT_JOBS=5
